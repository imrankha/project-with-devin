# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Optional: model used by the parse_list node (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# Where orders and LangGraph checkpoints are stored.
ORDERS_DB_PATH=data/orders.sqlite
CHECKPOINT_DB_PATH=data/checkpoints.sqlite

# Checkout agent: "playwright" drives the browser, "skip" bypasses it.
CHECKOUT_MODE=playwright
CHECKOUT_BASE_URL=http://localhost:5000/mock-shop
CHECKOUT_HEADLESS=true
# Login credentials the checkout agent uses. The bundled mock shop accepts
# the same values, so any non-empty pair works for the local demo.
CHECKOUT_USERNAME=demo
CHECKOUT_PASSWORD=change-me
